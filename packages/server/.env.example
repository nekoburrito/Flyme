# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flyme_dev

# Redis
REDIS_URL=redis://localhost:6379

# LLM — get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# External flight data (optional during early development)
SEATS_AERO_API_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173

# Set to "true" to log full Anthropic request/response payloads (dev only!)
LOG_LLM_REQUESTS=false
